# Product Carbon service configuration. Copy to service/.env (git-ignored).

# Required for AI estimates. Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Model -------------------------------------------------------------------
# claude-haiku-4-5   cheapest (default), roughly $0.02 per new estimate
# claude-sonnet-5    better reasoning, roughly $0.04-0.07
# claude-opus-5      best quality, roughly $0.20-0.45
# PCF_AI_MODEL=claude-haiku-4-5

# Sonnet 5 / Opus 5 only: low | medium | high | xhigh | max
# PCF_AI_EFFORT=high

# Haiku 4.5 only: 0 = no extended thinking (cheapest). Otherwise 1024 or more,
# and below PCF_AI_MAX_TOKENS. Thinking tokens are billed as output.
# PCF_AI_THINKING_BUDGET=0

# PCF_AI_MAX_TOKENS=16000

# --- Cost controls -------------------------------------------------------------
# Repeat searches for the same product, region and details are answered from
# cache at no cost. 0 disables the cache.
# PCF_CACHE_TTL_DAYS=30

# New (uncached) AI estimates allowed per client per hour. 0 = unlimited.
# PCF_RATE_LIMIT_PER_HOUR=30

# PCF_CORS_ORIGINS=http://localhost:5173
