# Website build settings. Copy to frontend/.env for local development.
# Everything here ends up in the public JavaScript: never put a secret in it.
# When publishing with `npm run deploy:pages`, set the IINVTY_* variables
# instead (see DEPLOY.md); the script maps them onto these.

# The backend API, including /api/v1. Locally the dev server proxies /api.
# VITE_API_BASE_URL=https://iinvty-backend.onrender.com/api/v1

# INSITY EDGE AI (Product Carbon estimates).
# VITE_PCF_API_BASE_URL=https://iinvty-insity-edge-ai.onrender.com

# Google OAuth Web client ID (SETUP-GOOGLE.md). Public by design. Empty = no Google button.
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Path the site is served under (set automatically by deploy:pages).
# VITE_BASE_PATH=/
