# Node Environment
NODE_ENV=development
PORT=5000

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# API Secrets (generate secure 256-bit strings for production)
API_SECRET_KEY=invty_secure_dev_key_2026_ghg_protocol

# Authentication
# Generate a real secret before deploying: openssl rand -base64 48
# The server refuses to start in production while this is the development default.
JWT_SECRET=invty-dev-only-jwt-secret-change-me-before-deploying
ACCESS_TOKEN_TTL=12h
MIN_PASSWORD_LENGTH=12

# Sign in with Google. Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials, add your app origin to
# "Authorised JavaScript origins", and paste the client ID here.
# Google sign-in is hidden while this is unset. No client secret is needed:
# the browser obtains an ID token and the server verifies it against Google.
GOOGLE_CLIENT_ID=

# Where the user store is written. Keep this off the web root and backed up.
DATA_DIR=./.data
