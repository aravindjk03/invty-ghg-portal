# Backend settings. Copy to backend/.env (git-ignored). On a host (Render,
# Koyeb, …) enter the same names in its environment settings instead.

# Node Environment
NODE_ENV=development
PORT=5000

# Database. Empty = a SQLite file in backend/data (fine on your computer).
# On any host whose disk is wiped on restart (Render/Koyeb free), set this to a
# Postgres database, e.g. a free Neon one, or every account is lost on restart:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# With Neon, `neon deploy` / `neon env pull` writes these to <repo>/.env.local,
# which the backend also reads, so nothing needs copying for local runs:
#   DATABASE_URL           pooled (-pooler) string: the app's queries
#   DATABASE_URL_UNPOOLED  direct string: creating the tables at start-up
# DATABASE_POOL_MAX=5
# How to reach Postgres: pg (default, TCP; for Render/Docker/VMs) or neon-http
# (Neon's serverless driver over HTTPS; for serverless/edge hosts).
# DATABASE_DRIVER=pg

# Sign-in tokens. REQUIRED in production (the server refuses to start on the
# development default). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=

# The first administrator. On an empty production database this account is
# created and a one-time password is printed once to the server log.
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_COMPANY=Your Company

# Google sign-in: the same Web client ID the website is built with
# (SETUP-GOOGLE.md). Empty = Google sign-in refused.
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Security & CORS: the website's address(es), comma-separated.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# The admin (operations console) site's own address, kept separate from the
# customer site. When set, /api/v1/ops answers only browser requests from here;
# from anywhere else it looks like an unknown route (404).
# ADMIN_ORIGIN=https://ops-<random>.yourdomain.com
# Optional: also restrict the console API to office / VPN addresses (IPs or CIDR).
# OPS_ALLOWED_IPS=203.0.113.0/24,2001:db8::/48

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Keys the audit chain and console-action log (generate a random one for production,
# same command as JWT_SECRET). Changing it later breaks verification of old entries.
API_SECRET_KEY=invty_secure_dev_key_2026_ghg_protocol

# Estimate metering. The free plan includes this many AI product estimates per
# account; after that the page asks the customer to upgrade.
FREE_ESTIMATE_LIMIT=2

# Lets the product carbon service spend a customer's estimate. Must be the SAME
# value on both sides, and it must never reach the browser. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# With this unset, /entitlements/reserve refuses every caller.
ESTIMATE_SERVICE_SECRET=
