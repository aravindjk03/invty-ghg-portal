# Node Environment
NODE_ENV=development
PORT=5000

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# API Secrets (generate secure 256-bit strings for production)
API_SECRET_KEY=invty_secure_dev_key_2026_ghg_protocol

# Estimate metering. The free plan includes this many AI product estimates per
# account; after that the page asks the customer to upgrade.
FREE_ESTIMATE_LIMIT=2

# Lets the product carbon service spend a customer's estimate. Must be the SAME
# value on both sides, and it must never reach the browser. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# With this unset, /entitlements/reserve refuses every caller.
ESTIMATE_SERVICE_SECRET=
