[{"key":"managed_soils","computes":["agri.fertiliser_n2o"],"name":"N2O from managed soils","scope":"1","gases":["N2O"],"source":"IPCC 2006 Volume 4 Chapter 11, Equations 11.1, 11.9 and 11.10","why_not_a_factor":"The N2O depends on how much nitrogen reached the soil and on what happened to the part that volatilised or leached away, not on the mass of product bought.","needs":["nitrogen applied, by source, in kilograms of N"],"options":{"nitrogen_content_examples":{"urea":"0.46","DAP":"0.18","ammonium sulphate":"0.21"}}},{"key":"lime_and_urea","computes":["agri.lime_application","agri.urea_application"],"name":"CO2 from liming and urea application","scope":"1","gases":["CO2"],"source":"IPCC 2006 Volume 4 Chapter 11, Equations 11.12 and 11.13","why_not_a_factor":"Limestone and dolomite carry different carbon, and urea has to be counted here as CO2 and again under managed soils as nitrogen.","needs":["tonnes of limestone, dolomite and urea applied"],"options":{"mass_unit":[{"value":"tonne","label":"Tonne"},{"value":"kg","label":"Kg"}]}},{"key":"enteric_fermentation","computes":["agri.enteric_fermentation"],"name":"CH4 from enteric fermentation","scope":"1","gases":["CH4"],"source":"IPCC 2006 Volume 4 Chapter 10, Tables 10.10 and 10.11","why_not_a_factor":"The factor per head differs by region because animal size and milk yield differ; poultry has no published factor at all.","needs":["head of each species","the region the cattle are farmed in"],"options":{"cattle_region":[{"value":"africa_middle_east","label":"Africa middle east"},{"value":"asia","label":"Asia"},{"value":"eastern_europe","label":"Eastern europe"},{"value":"indian_subcontinent","label":"Indian subcontinent"},{"value":"latin_america","label":"Latin america"},{"value":"north_america","label":"North america"},{"value":"oceania","label":"Oceania"},{"value":"western_europe","label":"Western europe"}],"other_animals":[{"value":"alpacas","label":"Alpacas"},{"value":"buffalo","label":"Buffalo"},{"value":"camels","label":"Camels"},{"value":"deer","label":"Deer"},{"value":"goats","label":"Goats"},{"value":"horses","label":"Horses"},{"value":"mules_and_asses","label":"Mules and asses"},{"value":"sheep","label":"Sheep"},{"value":"swine","label":"Swine"}],"not_published":{"poultry":"Table 10.10 records insufficient data for a Tier 1 enteric factor. Poultry enteric fermentation is not estimated here.","other_species":"Llamas and similar are 'to be determined' in Table 10.10."}}},{"key":"manure_management","computes":["agri.manure_management"],"name":"CH4 and N2O from manure management","scope":"1","gases":["CH4","N2O"],"source":"IPCC 2006 Volume 4 Chapter 10, Tables 10.14 to 10.16, 10.19, 10.21 to 10.23","why_not_a_factor":"The methane depends on the average annual temperature where the manure sits, and the nitrous oxide on how it is stored.","needs":["head of each species","average annual temperature","how the manure is stored, and the share on each system"],"options":{"region":[{"value":"africa","label":"Africa"},{"value":"asia","label":"Asia"},{"value":"eastern_europe","label":"Eastern europe"},{"value":"indian_subcontinent","label":"Indian subcontinent"},{"value":"latin_america","label":"Latin america"},{"value":"middle_east","label":"Middle east"},{"value":"north_america","label":"North america"},{"value":"oceania","label":"Oceania"},{"value":"western_europe","label":"Western europe"}],"species":[{"value":"breeding_swine","label":"Breeding swine"},{"value":"broilers","label":"Broilers"},{"value":"buffalo","label":"Buffalo"},{"value":"camels","label":"Camels"},{"value":"dairy_cows","label":"Dairy cows"},{"value":"deer","label":"Deer"},{"value":"ducks","label":"Ducks"},{"value":"fur_bearing","label":"Fur bearing"},{"value":"goats","label":"Goats"},{"value":"horses","label":"Horses"},{"value":"layers_dry","label":"Layers dry"},{"value":"layers_wet","label":"Layers wet"},{"value":"market_swine","label":"Market swine"},{"value":"mules_and_asses","label":"Mules and asses"},{"value":"other_cattle","label":"Other cattle"},{"value":"poultry","label":"Poultry"},{"value":"rabbits","label":"Rabbits"},{"value":"reindeer","label":"Reindeer"},{"value":"sheep","label":"Sheep"},{"value":"swine","label":"Swine"},{"value":"turkeys","label":"Turkeys"}],"excretion_region":[{"value":"north_america","label":"North america"},{"value":"western_europe","label":"Western europe"},{"value":"eastern_europe","label":"Eastern europe"},{"value":"oceania","label":"Oceania"},{"value":"latin_america","label":"Latin america"},{"value":"africa","label":"Africa"},{"value":"middle_east","label":"Middle east"},{"value":"asia","label":"Asia"}],"category":[{"value":"buffalo","label":"Buffalo"},{"value":"camels","label":"Camels"},{"value":"dairy_cattle","label":"Dairy cattle"},{"value":"goats","label":"Goats"},{"value":"horses","label":"Horses"},{"value":"other_cattle","label":"Other cattle"},{"value":"poultry","label":"Poultry"},{"value":"poultry_broilers","label":"Poultry broilers"},{"value":"poultry_ducks","label":"Poultry ducks"},{"value":"poultry_hens","label":"Poultry hens"},{"value":"poultry_other_chickens","label":"Poultry other chickens"},{"value":"poultry_pullets","label":"Poultry pullets"},{"value":"poultry_turkeys","label":"Poultry turkeys"},{"value":"sheep","label":"Sheep"},{"value":"swine","label":"Swine"},{"value":"swine_breeding","label":"Swine breeding"},{"value":"swine_market","label":"Swine market"}],"system":[{"value":"aerobic_treatment_forced_aeration","label":"Aerobic treatment forced aeration"},{"value":"aerobic_treatment_natural_aeration","label":"Aerobic treatment natural aeration"},{"value":"anaerobic_digester","label":"Anaerobic digester"},{"value":"composting_in_vessel","label":"Composting in vessel"},{"value":"composting_intensive_windrow","label":"Composting intensive windrow"},{"value":"composting_passive_windrow","label":"Composting passive windrow"},{"value":"composting_static_pile","label":"Composting static pile"},{"value":"daily_spread","label":"Daily spread"},{"value":"deep_bedding_active_mixing","label":"Deep bedding active mixing"},{"value":"deep_bedding_no_mixing","label":"Deep bedding no mixing"},{"value":"dry_lot","label":"Dry lot"},{"value":"liquid_slurry_with_crust","label":"Liquid slurry with crust"},{"value":"liquid_slurry_without_crust","label":"Liquid slurry without crust"},{"value":"pit_storage_below_animal_confinements","label":"Pit storage below animal confinements"},{"value":"poultry_manure_with_litter","label":"Poultry manure with litter"},{"value":"poultry_manure_without_litter","label":"Poultry manure without litter"},{"value":"solid_storage","label":"Solid storage"},{"value":"uncovered_anaerobic_lagoon","label":"Uncovered anaerobic lagoon"}],"reported_elsewhere":{"pasture_range_paddock":"Manure left where it falls is not manure management: it is reported under N2O from managed soils (Chapter 11, Section 11.2), which this library implements in managed_soils.py.","burned_for_fuel":"Dung burned as fuel is reported under Fuel Combustion, or under Waste Incineration if it is burned without energy recovery. The urine deposited on pasture goes to managed soils."}}},{"key":"rice_cultivation","computes":["agri.rice_cultivation"],"name":"CH4 from rice cultivation","scope":"1","gases":["CH4"],"source":"IPCC 2006 Volume 4 Chapter 5, Equations 5.1 to 5.3 and Tables 5.11 to 5.14","why_not_a_factor":"A paddy's methane depends on how long and how continuously it is flooded, whether it was flooded before planting, and what organic matter was ploughed in - not on the area alone.","needs":["harvested area and days of cultivation, per season","the water regime during and before the season","organic amendments applied, in tonnes per hectare"],"options":{"water_regime":[{"value":"upland","label":"Upland"},{"value":"irrigated_continuously_flooded","label":"Irrigated continuously flooded"},{"value":"irrigated_intermittent_single_aeration","label":"Irrigated intermittent single aeration"},{"value":"irrigated_intermittent_multiple_aeration","label":"Irrigated intermittent multiple aeration"},{"value":"rainfed_regular","label":"Rainfed regular"},{"value":"rainfed_drought_prone","label":"Rainfed drought prone"},{"value":"deep_water","label":"Deep water"}],"pre_season":[{"value":"non_flooded_under_180_days","label":"Non flooded under 180 days"},{"value":"non_flooded_over_180_days","label":"Non flooded over 180 days"},{"value":"flooded_over_30_days","label":"Flooded over 30 days"}],"amendment":[{"value":"straw_under_30_days_before","label":"Straw under 30 days before"},{"value":"straw_over_30_days_before","label":"Straw over 30 days before"},{"value":"compost","label":"Compost"},{"value":"farmyard_manure","label":"Farmyard manure"},{"value":"green_manure","label":"Green manure"}]}},{"key":"wastewater","computes":["fugitive.ch4_wastewater","fugitive.n2o_wastewater"],"name":"CH4 and N2O from wastewater","scope":"1","gases":["CH4","N2O"],"source":"IPCC 2006 Volume 5 Chapter 6, Equations 6.2, 6.3, 6.7 and 6.8","why_not_a_factor":"A factor per cubic metre would assume a strength of effluent nobody measured. The methane follows the organic load, the nitrous oxide the nitrogen discharged.","needs":["organic load as BOD or COD","the treatment route","population and protein intake, for the nitrogen"],"options":{"system":[{"value":"anaerobic_deep_lagoon","label":"Anaerobic deep lagoon"},{"value":"anaerobic_digester_sludge","label":"Anaerobic digester sludge"},{"value":"anaerobic_reactor","label":"Anaerobic reactor"},{"value":"anaerobic_shallow_lagoon","label":"Anaerobic shallow lagoon"},{"value":"centralised_aerobic_overloaded","label":"Centralised aerobic overloaded"},{"value":"centralised_aerobic_well_managed","label":"Centralised aerobic well managed"},{"value":"flowing_sewer","label":"Flowing sewer"},{"value":"latrine_dry_communal","label":"Latrine dry communal"},{"value":"latrine_dry_small_family","label":"Latrine dry small family"},{"value":"latrine_sediment_removed","label":"Latrine sediment removed"},{"value":"latrine_wet_climate_flush","label":"Latrine wet climate flush"},{"value":"sea_river_lake_discharge","label":"Sea river lake discharge"},{"value":"septic_system","label":"Septic system"},{"value":"stagnant_sewer","label":"Stagnant sewer"}],"load_basis":[{"value":"BOD","label":"BOD"},{"value":"COD","label":"COD"}]}},{"key":"solid_waste","computes":[],"name":"CH4 from solid waste disposal","scope":"1","gases":["CH4"],"source":"IPCC 2006 Volume 5 Chapter 3, Equations 3.1 to 3.6 (First Order Decay)","why_not_a_factor":"Waste buried this year emits nothing this year, and waste buried a decade ago is still decaying. The model needs the disposal history.","needs":["tonnes disposed in each year, not just this year","the kind of site and the climate zone"],"options":{"site_type":[{"value":"managed_anaerobic","label":"Managed anaerobic"},{"value":"managed_semi_aerobic","label":"Managed semi aerobic"},{"value":"unmanaged_deep","label":"Unmanaged deep"},{"value":"unmanaged_shallow","label":"Unmanaged shallow"},{"value":"uncategorised","label":"Uncategorised"}],"component":[{"value":"paper_cardboard","label":"Paper cardboard"},{"value":"textiles","label":"Textiles"},{"value":"wood","label":"Wood"},{"value":"garden_and_park","label":"Garden and park"},{"value":"food","label":"Food"},{"value":"sewage_sludge","label":"Sewage sludge"},{"value":"bulk","label":"Bulk"}],"industrial_component":[{"value":"food_beverages_tobacco","label":"Food beverages tobacco"},{"value":"textile","label":"Textile"},{"value":"wood_and_wood_products","label":"Wood and wood products"},{"value":"pulp_and_paper","label":"Pulp and paper"},{"value":"petroleum_solvents_plastics","label":"Petroleum solvents plastics"},{"value":"rubber","label":"Rubber"},{"value":"construction_and_demolition","label":"Construction and demolition"},{"value":"other_manufacturing","label":"Other manufacturing"}],"climate_zone":[{"value":"boreal_temperate_dry","label":"Boreal temperate dry"},{"value":"boreal_temperate_wet","label":"Boreal temperate wet"},{"value":"tropical_dry","label":"Tropical dry"},{"value":"tropical_moist_wet","label":"Tropical moist wet"}],"climate_zone_help":{"boreal_temperate_dry":"mean annual temperature at or below 20 C, MAP/PET below 1","boreal_temperate_wet":"mean annual temperature at or below 20 C, MAP/PET above 1","tropical_dry":"mean annual temperature above 20 C, mean annual precipitation below 1000 mm","tropical_moist_wet":"mean annual temperature above 20 C, mean annual precipitation at or above 1000 mm"},"composition_region":[{"value":"australia_new_zealand","label":"Australia new zealand"},{"value":"caribbean","label":"Caribbean"},{"value":"central_america","label":"Central america"},{"value":"eastern_africa","label":"Eastern africa"},{"value":"eastern_asia","label":"Eastern asia"},{"value":"eastern_europe","label":"Eastern europe"},{"value":"middle_africa","label":"Middle africa"},{"value":"north_america","label":"North america"},{"value":"northern_africa","label":"Northern africa"},{"value":"northern_europe","label":"Northern europe"},{"value":"rest_of_oceania","label":"Rest of oceania"},{"value":"south_america","label":"South america"},{"value":"south_central_asia","label":"South central asia"},{"value":"south_eastern_asia","label":"South eastern asia"},{"value":"southern_africa","label":"Southern africa"},{"value":"southern_europe","label":"Southern europe"},{"value":"western_africa","label":"Western africa"},{"value":"western_asia_middle_east","label":"Western asia middle east"},{"value":"western_europe","label":"Western europe"}],"no_decay_rate":{"nappies":"Table 3.3 has no row for nappies, and they are part paper, part plastic and part excreta. Give a k, or split the stream.","rubber_and_leather":"Table 3.3 has no row for rubber and leather, and Table 2.4 brackets its DOC because natural rubber is unlikely to degrade anaerobically."}}},{"key":"mineral_industry","computes":["process.cement_clinker","process.lime_calcination","process.dolomite_calcination","process.limestone_flux","process.soda_ash_use","process.glass_carbonates","process.ceramics","process.pulp_paper_lime_kiln","process.phosphoric_acid"],"name":"CO2 from cement, lime, glass and carbonates","scope":"1","gases":["CO2"],"source":"IPCC 2006 Volume 3 Chapter 2, Equations 2.4 and 2.8 and Tables 2.1, 2.4, 2.6","why_not_a_factor":"The CO2 comes out of the limestone, not out of the fuel that heats it. For a cement works this is usually more than half the inventory, and no fuel factor covers any of it.","needs":["tonnes of clinker, lime or glass made","tonnes of any other carbonate calcined, and how much of it calcined"],"options":{"lime_type":[{"value":"default_mix","label":"Default mix"},{"value":"dolomitic_developed","label":"Dolomitic developed"},{"value":"dolomitic_developing","label":"Dolomitic developing"},{"value":"high_calcium","label":"High calcium"},{"value":"hydraulic","label":"Hydraulic"}],"glass_type":[{"value":"container_amber_green","label":"Container amber green"},{"value":"container_flint","label":"Container flint"},{"value":"fibreglass_e_glass","label":"Fibreglass e glass"},{"value":"fibreglass_insulation","label":"Fibreglass insulation"},{"value":"float","label":"Float"},{"value":"specialty_lab_pharma","label":"Specialty lab pharma"},{"value":"specialty_lighting","label":"Specialty lighting"},{"value":"specialty_tableware","label":"Specialty tableware"},{"value":"specialty_tv_funnel","label":"Specialty tv funnel"},{"value":"specialty_tv_panel","label":"Specialty tv panel"}],"carbonate":[{"value":"dolomite","label":"Dolomite"},{"value":"limestone_caco3","label":"Limestone caco3"},{"value":"magnesite_mgco3","label":"Magnesite mgco3"},{"value":"rhodochrosite_mnco3","label":"Rhodochrosite mnco3"},{"value":"siderite_feco3","label":"Siderite feco3"},{"value":"soda_ash_na2co3","label":"Soda ash na2co3"}],"clinker_cao_content":[{"value":"60_percent_cao","label":"60 percent cao"},{"value":"65_percent_cao","label":"65 percent cao"},{"value":"67_percent_cao","label":"67 percent cao"}]}},{"key":"chemical_industry","computes":["process.ammonia_production","process.nitric_acid","process.adipic_acid","process.urea_production","process.calcium_carbide","process.silicon_carbide","process.titanium_dioxide","process.methanol_production","process.ethylene_petchem","process.carbon_black","process.hfc23_byproduct"],"name":"CO2 and N2O from ammonia, nitric acid, adipic acid and carbides","scope":"1","gases":["CO2","N2O","CH4"],"source":"IPCC 2006 Volume 3 Chapter 3, Tables 3.1, 3.3, 3.4, 3.7, 3.8, 3.9","why_not_a_factor":"A nitric acid plant makes N2O in the reaction itself, and how much depends on the plant type and on whether its abatement was actually running.","needs":["tonnes of product","the process route and any abatement fitted"],"options":{"ammonia_process":[{"value":"autothermal_reforming_natural_gas","label":"Autothermal reforming natural gas"},{"value":"average_natural_gas","label":"Average natural gas"},{"value":"average_partial_oxidation","label":"Average partial oxidation"},{"value":"conventional_reforming_natural_gas","label":"Conventional reforming natural gas"},{"value":"excess_air_reforming_natural_gas","label":"Excess air reforming natural gas"},{"value":"partial_oxidation","label":"Partial oxidation"}],"nitric_acid_plant_type":[{"value":"atmospheric_pressure","label":"Atmospheric pressure"},{"value":"high_pressure","label":"High pressure"},{"value":"medium_pressure_combustion","label":"Medium pressure combustion"},{"value":"nscr_all_processes","label":"Nscr all processes"},{"value":"process_integrated_or_tailgas_destruction","label":"Process integrated or tailgas destruction"}],"adipic_acid_abatement":[{"value":"catalytic_destruction","label":"Catalytic destruction"},{"value":"recycle_to_adipic_feedstock","label":"Recycle to adipic feedstock"},{"value":"recycle_to_nitric_acid","label":"Recycle to nitric acid"},{"value":"thermal_destruction","label":"Thermal destruction"}],"carbide_type":[{"value":"calcium_carbide","label":"Calcium carbide"},{"value":"silicon_carbide","label":"Silicon carbide"}],"carbide_basis":[{"value":"product","label":"Product"},{"value":"petroleum_coke","label":"Petroleum coke"},{"value":"carbide_used","label":"Carbide used"}],"titanium_dioxide_product":[{"value":"rutile_tio2_chloride_route","label":"Rutile tio2 chloride route"},{"value":"synthetic_rutile","label":"Synthetic rutile"}],"methanol_process":[{"value":"conventional_steam_reforming_natural_gas","label":"Conventional steam reforming natural gas"},{"value":"conventional_steam_reforming_with_primary_reformer","label":"Conventional steam reforming with primary reformer"},{"value":"lurgi_combined","label":"Lurgi combined"},{"value":"lurgi_conventional_natural_gas","label":"Lurgi conventional natural gas"},{"value":"lurgi_conventional_natural_gas_plus_co2","label":"Lurgi conventional natural gas plus co2"},{"value":"lurgi_low_pressure","label":"Lurgi low pressure"},{"value":"lurgi_mega_methanol","label":"Lurgi mega methanol"},{"value":"partial_oxidation_coal","label":"Partial oxidation coal"},{"value":"partial_oxidation_lignite","label":"Partial oxidation lignite"},{"value":"partial_oxidation_oil","label":"Partial oxidation oil"},{"value":"steam_reforming_integrated_ammonia","label":"Steam reforming integrated ammonia"}],"ethylene_feedstock":[{"value":"butane","label":"Butane"},{"value":"ethane","label":"Ethane"},{"value":"gas_oil","label":"Gas oil"},{"value":"naphtha","label":"Naphtha"},{"value":"other","label":"Other"},{"value":"propane","label":"Propane"}],"ethylene_region":[{"value":"americas_and_australia","label":"Americas and australia"},{"value":"asia_africa_russia","label":"Asia africa russia"},{"value":"eastern_europe","label":"Eastern europe"},{"value":"japan_and_korea","label":"Japan and korea"},{"value":"western_europe","label":"Western europe"}],"carbon_black_process":[{"value":"acetylene_black","label":"Acetylene black"},{"value":"furnace_black","label":"Furnace black"},{"value":"thermal_black","label":"Thermal black"}],"hfc23_plant":[{"value":"global_average_1978_1995","label":"Global average 1978 1995"},{"value":"old_unoptimised","label":"Old unoptimised"},{"value":"recent_not_optimised","label":"Recent not optimised"}],"not_published":{"titanium_slag":"IPCC publishes no default: only two plants make it and their data is confidential. A plant that makes it has to use its own reductant and carbothermal input."}}},{"key":"metal_industry","computes":["process.iron_steel_bf","process.iron_steel_dri","process.iron_steel_eaf_electrode","process.ferroalloys","process.aluminium_anode","process.aluminium_pfc","process.lead_production","process.zinc_production"],"name":"CO2, CH4, PFCs and SF6 from iron, steel, ferroalloys, aluminium and more","scope":"1","gases":["CO2","CH4","CF4","C2F6","SF6"],"source":"IPCC 2006 Volume 3 Chapter 4, Tables 4.1, 4.2, 4.5, 4.10, 4.15, 4.20, 4.21, 4.24","why_not_a_factor":"The carbon is the reductant, not a fuel, and an aluminium cell makes CF4 and C2F6 during an anode effect. The route matters more than the tonnage: scrap through an arc furnace is a eighteenth of iron through a basic oxygen furnace.","needs":["tonnes of each product","the furnace or cell technology"],"options":{"steel_step":[{"value":"coke_oven","label":"Coke oven"},{"value":"direct_reduced_iron","label":"Direct reduced iron"},{"value":"pellet","label":"Pellet"},{"value":"pig_iron_blast_furnace","label":"Pig iron blast furnace"},{"value":"sinter","label":"Sinter"},{"value":"steel_basic_oxygen_furnace","label":"Steel basic oxygen furnace"},{"value":"steel_electric_arc_furnace","label":"Steel electric arc furnace"},{"value":"steel_global_average","label":"Steel global average"},{"value":"steel_open_hearth_furnace","label":"Steel open hearth furnace"}],"ferroalloy_type":[{"value":"ferrochromium","label":"Ferrochromium"},{"value":"ferrochromium_with_sinter_plant","label":"Ferrochromium with sinter plant"},{"value":"ferromanganese_1_percent_c","label":"Ferromanganese 1 percent c"},{"value":"ferromanganese_7_percent_c","label":"Ferromanganese 7 percent c"},{"value":"ferrosilicon_45_percent_si","label":"Ferrosilicon 45 percent si"},{"value":"ferrosilicon_65_percent_si","label":"Ferrosilicon 65 percent si"},{"value":"ferrosilicon_75_percent_si","label":"Ferrosilicon 75 percent si"},{"value":"ferrosilicon_90_percent_si","label":"Ferrosilicon 90 percent si"},{"value":"silicomanganese","label":"Silicomanganese"},{"value":"silicon_metal","label":"Silicon metal"}],"aluminium_cell_technology":[{"value":"cwpb","label":"Cwpb"},{"value":"hss","label":"Hss"},{"value":"swpb","label":"Swpb"},{"value":"vss","label":"Vss"}],"lead_route":[{"value":"default_mix","label":"Default mix"},{"value":"direct_smelting","label":"Direct smelting"},{"value":"imperial_smelting_furnace","label":"Imperial smelting furnace"},{"value":"secondary_raw_materials","label":"Secondary raw materials"}],"zinc_process":[{"value":"default_mix","label":"Default mix"},{"value":"pyrometallurgical_imperial_smelting","label":"Pyrometallurgical imperial smelting"},{"value":"waelz_kiln","label":"Waelz kiln"}],"not_published":{"electro_thermic":"IPCC records the electro-thermic factor as unknown."}}}]